# Copie para config.env e ajuste. Variáveis de ambiente/flags também funcionam.

# Nome da sessão no Colab CLI
SESSION=colab-llm

# GPU: T4 | L4 | G4 | A100 | H100 (disponibilidade depende do plano: Free só T4)
GPU=T4
# 1 = máquina com mais RAM (Pro/Pro+)
HIGH_MEM=0

# Modelos do Ollama, separados por vírgula (https://ollama.com/library)
MODELS=qwen2.5:7b

# Nome da máquina na tailnet -> http://colab-gpu:11434
TS_HOSTNAME=colab-gpu
# Opcional: tags (obrigatório se TS_AUTHKEY for um OAuth client secret tskey-client-...)
TS_TAGS=
# Arquivo com a auth key (reusable + ephemeral + pre-approved). Sem ela, você recebe um link de login.
TS_AUTHKEY_FILE=$HOME/.config/colab-llm/ts_authkey

OLLAMA_PORT=11434
# opencode e agentes precisam de contexto grande (o prompt de sistema+tools passa de 10k tokens)
OLLAMA_CONTEXT_LENGTH=32768

# auto = ao final do `up`, adiciona/atualiza o provider "colab" no opencode (se instalado). 0 = não mexe.
OPENCODE=auto

# O Colab desliga VMs com o kernel ocioso (chamadas à API não contam). O `up` deixa um keepalive
# em segundo plano executando algo no kernel a cada N minutos; o `down` encerra. 0 = desliga.
KEEPALIVE_MIN=5
